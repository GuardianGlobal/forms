{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "./src",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"#src/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.test.ts"],
	"exclude": ["vitest.config.ts"]
}
